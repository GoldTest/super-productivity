{
  "name": "super-productivity-desktop-widget",
  "version": "1.0.0",
  "description": "Clean, glassmorphic desktop floating companion widget for Super Productivity",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "widget": "npx electron .",
    "dist": "npx electron-packager . \"Super Focus Widget\" --platform=win32 --arch=x64 --out=dist --overwrite --asar"
  },
  "build": {
    "electronVersion": "44.7.0",
    "appId": "com.superproductivity.desktopwidget",
    "productName": "Super Focus Widget",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "keywords": [
    "super-productivity",
    "widget",
    "floating-window",
    "pomodoro",
    "tasks"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0"
  }
}
